# Streamlit Secrets Configuration Example
# Copy this to your Streamlit Cloud app's Secrets section
# DO NOT commit the actual secrets.toml file with real data!

# Option 1: Store as CSV string (simpler)
[secrets]
final_address_csv = """
Slno,State,Entity name,GST No,FC Data,FC Name,FC Seller Address 1,FC Seller Address 1.1,Seller Pin code,Location Status,HUB/FC,Hub Name,Name,Fssai,Address,HUB Buyers Address 1,HUB Buyers Address 1.1,HUB Buyers Pin code
1,Telangana,COMPANY NAME,36XXXXX0000X0XX,FC,FC-Hyderabad,"FC Address Line 1","FC Address Line 2",500078,Active,HUB,HYD_ATP,Attapur,00000000000000,"Jumbotail Technologies Pvt Ltd, 13-6-445/3/A at KRKM Gardens","Konijeti Enclave behind Vegetable Market","Gudimalkapur, Hyderabad, Telangana",500028
...add all your rows here...
"""

# Option 2: Store as JSON (for programmatic access)
[final_address_data]
data = '''
[
  {
    "Slno": 1,
    "State": "Telangana",
    "Entity name": "COMPANY NAME",
    "GST No": "36XXXXX0000X0XX",
    "Hub Name": "HYD_ATP",
    "HUB Buyers Address 1": "Address Line 1",
    "HUB Buyers Address 1.1": "Address Line 2",
    "HUB Buyers Pin code": "500028"
  }
]
'''

# Hub Addresses
[hub_addresses]
HYD_ATP = "Jumbotail Technologies Pvt Ltd, 13-6-445/3/A at KRKM Gardens, Konijeti Enclave behind Vegetable Market, Gudimalkapur, Hyderabad, Telangana, 500028"
HYD_SAN = "Your Santosh Nagar address here"
HYD_NCH = "Your Nacharam address here"

# Organization Names
[org_names]
"12345" = "Sample Organization 1"
"67890" = "Sample Organization 2"

# Database connection (if using external DB)
[database]
host = "your-database-host.com"
port = 5432
username = "your-username"
password = "your-secure-password"
database = "your-database-name"

# Supabase (if using Supabase)
[supabase]
url = "https://your-project.supabase.co"
key = "your-supabase-anon-key"

# Environment flags
[environment]
IS_STREAMLIT_CLOUD = "true"
